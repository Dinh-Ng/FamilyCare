<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.FamilyCare" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.FamilyCare" parent="Base.Theme.FamilyCare">
        <!-- Active indicator của BottomNavigationView dùng colorSecondaryContainer -->
        <item name="colorSecondaryContainer">@color/nav_indicator_color</item>
        <!-- Icon/text màu khi active dùng colorOnSecondaryContainer -->
        <item name="colorOnSecondaryContainer">@color/nav_selected_tint</item>
    </style>

    <style name="BottomNavTextActive" parent="@style/TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="BottomNavTextInactive" parent="@style/TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">12sp</item>
    </style>

    <style name="CircularImageView">
        <item name="cornerSize">50%</item>
    </style>
</resources>