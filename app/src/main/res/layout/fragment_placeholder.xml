<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollViewHealth"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4FAF8"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp">

        <!-- 1. Header Bar Component -->
        <include layout="@layout/layout_health_header" />

        <!-- 2. Family Members Component -->
        <include layout="@layout/layout_health_members" />

        <!-- 3. Physical Indicators Component -->
        <include layout="@layout/layout_health_physical_indicators" />

        <!-- 4. Adult BMI Gauge Component -->
        <include layout="@layout/layout_health_bmi_gauge" />

        <!-- 5. WHO Growth Chart Component -->
        <include layout="@layout/layout_health_who_growth_chart" />

        <!-- 6. Alerts & Medical History Component -->
        <include layout="@layout/layout_health_medical_history" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
