<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardWhoChart"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="#E2E8F0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <TextView
            android:id="@+id/tvWhoTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Biểu đồ Tăng trưởng WHO"
            android:textColor="#0F5C4C"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvWhoSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Trẻ em 0 - 5 tuổi (Bé trai) • Cập nhật tự động"
            android:textColor="#64748B"
            android:textSize="12sp" />

        <!-- Status Chip -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_chip_mint"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="Status check"
                android:src="@drawable/ic_check_circle" />

            <TextView
                android:id="@+id/tvWhoStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Bình thường"
                android:textColor="#0F5C4C"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Filter Tabs -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:weightSum="3">

            <TextView
                android:id="@+id/tabHaz"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_selected_green"
                android:gravity="center"
                android:paddingVertical="8dp"
                android:text="Chiều cao\n(HAZ)"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tabWaz"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_grey"
                android:gravity="center"
                android:paddingVertical="8dp"
                android:text="Cân nặng\n(WAZ)"
                android:textColor="#475569"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tabBmiForAge"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_grey"
                android:gravity="center"
                android:paddingVertical="8dp"
                android:text="BMI-for-Age"
                android:textColor="#475569"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Chart Canvas Container -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_who_chart"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvYAxisLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chiều cao (cm)"
                android:textColor="#64748B"
                android:textSize="11sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout
                android:id="@+id/tooltipContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+0.2 SD (Lý tưởng)"
                    android:textColor="#059669"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/bg_chip_selected_green"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="5t: 109.5 cm"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Y-Axis Values -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/yAxisValues"
                android:layout_width="wrap_content"
                android:layout_height="90dp"
                android:layout_marginTop="8dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvYAxisLabel">

                <TextView
                    android:id="@+id/tvVal115"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="115"
                    android:textColor="#94A3B8"
                    android:textSize="10sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvVal105"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="105"
                    android:textColor="#94A3B8"
                    android:textSize="10sp"
                    app:layout_constraintBottom_toTopOf="@id/tvVal95"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvVal115" />

                <TextView
                    android:id="@+id/tvVal95"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="95"
                    android:textColor="#94A3B8"
                    android:textSize="10sp"
                    app:layout_constraintBottom_toTopOf="@id/tvVal85"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvVal105" />

                <TextView
                    android:id="@+id/tvVal85"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="85"
                    android:textColor="#94A3B8"
                    android:textSize="10sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Chart Line Canvas Graphic -->
            <ImageView
                android:id="@+id/imgWhoChartGraph"
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_marginStart="8dp"
                android:contentDescription="Biểu đồ tăng trưởng"
                android:scaleType="fitXY"
                android:src="@drawable/ic_who_chart_graph"
                app:layout_constraintBottom_toBottomOf="@id/yAxisValues"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/yAxisValues"
                app:layout_constraintTop_toTopOf="@id/yAxisValues" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Chart Legend Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_badge_dot_green" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="Bé Bo (Thực tế)"
                    android:textColor="#334155"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="12dp"
                    android:layout_height="2.5dp"
                    android:background="#0F5C4C" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="Chuẩn WHO"
                    android:textColor="#334155"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="12dp"
                    android:layout_height="2.5dp"
                    android:background="#FCA5A5" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="Ngưỡng ±2SD"
                    android:textColor="#334155"
                    android:textSize="11sp" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
