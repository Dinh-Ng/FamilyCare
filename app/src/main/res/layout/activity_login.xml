<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0FBF7"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="16dp">

        <!-- LOGO -->
        <FrameLayout
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_logo_circle">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:contentDescription="Biểu tượng Family Care"
                android:src="@drawable/ic_family_care" />
        </FrameLayout>

        <!-- TÊN ỨNG DỤNG -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="10dp"
            android:text="Family Care"
            android:textColor="#007F6B"
            android:textSize="23sp"
            android:textStyle="bold" />

        <!-- GIỚI THIỆU -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="3dp"
            android:text="Đồng hành sức khỏe cùng gia đình bạn"
            android:textColor="#647C75"
            android:textSize="12sp" />

        <!-- NHÃN ĐĂNG NHẬP -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_login_badge"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:drawableStart="@drawable/ic_login_lock"
            android:drawablePadding="4dp"
            android:text="ĐĂNG NHẬP TÀI KHOẢN"
            android:textColor="#007F6B"
            android:textSize="9sp"
            android:textStyle="bold" />

        <!-- KHUNG ĐĂNG NHẬP -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_login_card"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- EMAIL -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Email / Tên đăng nhập"
                android:textColor="#263B35"
                android:textSize="11sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtEmail"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:drawableStart="@drawable/ic_email"
                android:drawablePadding="8dp"
                android:hint="example@gmail.com"
                android:inputType="textEmailAddress"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:singleLine="true"
                android:textColor="#263B35"
                android:textColorHint="#91A59E"
                android:textSize="12sp" />

            <!-- MẬT KHẨU -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Mật khẩu"
                android:textColor="#263B35"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/edtPassword"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:drawableStart="@drawable/ic_login_lock"
                    android:drawablePadding="8dp"
                    android:hint="Nhập mật khẩu"
                    android:inputType="textPassword"
                    android:paddingStart="14dp"
                    android:singleLine="true"
                    android:textColor="#263B35"
                    android:textColorHint="#91A59E"
                    android:textSize="12sp" />

                <ImageButton
                    android:id="@+id/btnTogglePassword"
                    android:layout_width="42dp"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:contentDescription="Ẩn hoặc hiện mật khẩu"
                    android:src="@android:drawable/ic_menu_view"
                    android:tint="#70877F" />
            </LinearLayout>

            <!-- GHI NHỚ VÀ QUÊN MẬT KHẨU -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/cbRemember"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="#00866F"
                    android:checked="true"
                    android:padding="0dp"
                    android:text="Ghi nhớ đăng nhập"
                    android:textColor="#354B44"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tvForgotPassword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="5dp"
                    android:text="Quên mật khẩu?"
                    android:textColor="#007F6B"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- NÚT ĐĂNG NHẬP -->
            <Button
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="9dp"
                android:background="@drawable/bg_primary_button"
                android:text="Đăng nhập  →"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- PHÂN CÁCH -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#D8E9E2" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="Hoặc tiếp tục với"
                android:textColor="#81958D"
                android:textSize="10sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#D8E9E2" />

        </LinearLayout>

        <!-- GOOGLE -->
        <FrameLayout
            android:id="@+id/btnGoogle"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_google_button"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="Google"
                    android:src="@drawable/ic_google_g" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Đăng nhập bằng Google"
                    android:textColor="#263B35"
                    android:textSize="11sp" />
            </LinearLayout>
        </FrameLayout>

        <!-- ĐĂNG KÝ -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chưa có tài khoản ? "
                android:textColor="#657C74"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvRegister"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" Đăng ký ngay"
                android:textColor="#007F6B"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
