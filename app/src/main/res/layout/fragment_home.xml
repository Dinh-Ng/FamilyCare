<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header & Members component -->
        <include layout="@layout/layout_home_header" />

        <!-- Health stats card component -->
        <include layout="@layout/layout_home_health_card" />

        <!-- Today's schedule component -->
        <include layout="@layout/layout_home_schedule_section" />

        <!-- Today's nutrition card component -->
        <include layout="@layout/layout_home_nutrition_card" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>