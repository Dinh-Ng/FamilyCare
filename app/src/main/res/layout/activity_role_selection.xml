<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0FBF7"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:gravity="center"
                android:id="@+id/btnRoleBack"
                android:text="‹"
                android:textColor="#355B52"
                android:textSize="28sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_login_badge"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="♙  Bước 1/3: Chọn vai trò của bạn"
                android:textColor="#16836F"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">
            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="#087E6A" />
            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="#DDECE7" />
            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="#DDECE7" />
        </LinearLayout>

        <TextView
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_login_badge"
            android:gravity="center"
            android:text="◉"
            android:textColor="#087E6A"
            android:textSize="28sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="Vai trò của bạn trong nhà?"
            android:textColor="#172C27"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/cardParentRole"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_login_card"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_input"
                    android:gravity="center"
                    android:text="♧"
                    android:textColor="#087E6A"
                    android:textSize="23sp" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="QUẢN TRỊ VIÊN"
                        android:textColor="#55746B"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Bố / Mẹ"
                        android:textColor="#1D332D"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <TextView
                    android:id="@+id/indicatorParent"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_primary_button"
                    android:gravity="center"
                    android:text="✓"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Chủ động chăm sóc, giám sát và quản lý sức khỏe tổng thể của mọi thành viên."
                android:textColor="#526C63"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:text="●  Tạo nhóm gia đình và nhận mã mời Family Code&#10;●  Quản lý hồ sơ bệnh án, lịch uống thuốc cả nhà&#10;●  Phân bổ thực đơn dinh dưỡng và mời thành viên"
                android:textColor="#35594E"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardMemberRole"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_login_card"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="14dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_input"
                    android:gravity="center"
                    android:text="♙"
                    android:textColor="#55746B"
                    android:textSize="22sp" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="THÀNH VIÊN"
                        android:textColor="#82958E"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Ông / Bà"
                        android:textColor="#263B35"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <TextView
                    android:id="@+id/indicatorMember"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:background="@drawable/bg_input"
                    android:gravity="center"
                    android:text="○"
                    android:textColor="#9CAFA8"
                    android:textSize="18sp" />
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Dành cho ông bà hoặc người thân chăm sóc trong gia đình."
                android:textColor="#526C63"
                android:textSize="12sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:text="○  Nhận thông báo nhắc nhở uống thuốc&#10;○  Xem thực đơn dinh dưỡng phù hợp với tình trạng sức khỏe&#10;○  Dễ dàng gửi phản hồi, yêu cầu hỗ trợ"
                android:textColor="#657C74"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_primary_button"
            android:gravity="center"
            android:id="@+id/btnContinueRole"
            android:text="Tiếp tục với vai trò Bố / Mẹ  →"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />


    </LinearLayout>
</ScrollView>